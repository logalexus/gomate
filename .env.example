DB_PASSWORD=replace-with-a-random-password
WEB_LOGIN=packmate
WEB_PASSWORD=replace-with-a-different-random-password
DB_PORT=65432
LISTEN=127.0.0.1:65000
# Initial values only; subsequent configuration is persisted in the DB and edited in UI.
# Leave INTERFACE empty to start without capture, then choose it in Settings.
# Empty LOCAL_IPS derives addresses from the selected interface.
INTERFACE=
LOCAL_IPS=
RETENTION=1h

# Separate random token for the local Docker discovery gateway.
DOCKER_DISCOVERY_TOKEN=replace-with-another-random-secret-at-least-24-characters
